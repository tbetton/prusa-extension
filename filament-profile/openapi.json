{
  "openapi": "3.1.0",
  "info": {
    "title": "filament-profile",
    "version": "0.1.1",
    "description": "PrusaSlicer 2.9 filament profiles for the spools on a printer. Every path is relative to the mount the host assigns."
  },
  "components": {
    "schemas": {
      "Status": {
        "type": "object",
        "properties": {
          "ready": {
            "type": "boolean"
          },
          "refreshing": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "presets": {
            "type": "integer"
          },
          "updated_at": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "sources": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "The number of presets each source gave."
          },
          "enabled": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The sources the operator chose to offer."
          }
        },
        "required": [
          "ready",
          "refreshing",
          "presets"
        ]
      },
      "Candidate": {
        "type": "object",
        "properties": {
          "preset": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string",
            "description": "Where the preset comes from: prusa, polymaker or custom."
          },
          "section": {
            "type": "string",
            "description": "The section written for the printer asked about."
          },
          "adapted": {
            "type": "boolean",
            "description": "The preset does not fit that printer as written: its material settings are laid over a generic preset of the printer."
          }
        },
        "required": [
          "preset",
          "variants"
        ]
      },
      "Request": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "base": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "color_rgba": {
            "type": "string"
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32,
            "description": "The filament position in PrusaSlicer, from 1. The bundle's [presets] section selects the profile there on import. 0 or absent leaves the selection alone."
          },
          "properties": {
            "$ref": "#/components/schemas/Properties"
          }
        },
        "required": [
          "name",
          "base"
        ]
      },
      "Properties": {
        "type": "object",
        "description": "What the OpenPrintTag catalogue says of the spool's material. A zero or absent value is unknown.",
        "properties": {
          "min_print_temp": {
            "type": "integer"
          },
          "max_print_temp": {
            "type": "integer"
          },
          "min_bed_temp": {
            "type": "integer"
          },
          "max_bed_temp": {
            "type": "integer"
          },
          "density": {
            "type": "number"
          }
        }
      },
      "Printer": {
        "type": "object",
        "description": "One printer preset of PrusaSlicer.",
        "properties": {
          "name": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "variant": {
            "type": "string"
          },
          "extruders": {
            "type": "integer"
          },
          "nozzle_diameter": {
            "type": "number"
          },
          "high_flow": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "extruders",
          "high_flow"
        ]
      }
    }
  },
  "paths": {
    "/catalogue": {
      "get": {
        "operationId": "get-catalogue",
        "summary": "State of the downloaded Prusa profiles",
        "description": "The host authorizes the caller on this module before the route is called.",
        "responses": {
          "200": {
            "description": "The catalogue's state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/catalogue/refresh": {
      "post": {
        "operationId": "refresh-catalogue",
        "summary": "Download the Prusa profiles again",
        "description": "Starts the download in the background and answers at once. Poll GET /catalogue.",
        "responses": {
          "202": {
            "description": "The download runs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "503": {
            "description": "The module is starting."
          }
        }
      }
    },
    "/match": {
      "get": {
        "operationId": "match-filament",
        "summary": "The nearest Prusa presets for a spool",
        "description": "Ranks the base presets of the spool's brand against its name. The generic preset of the type closes the list.",
        "parameters": [
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "printer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "A printer preset name. Only presets that fit it are returned, as PrusaSlicer's own list shows them."
          }
        ],
        "responses": {
          "200": {
            "description": "Up to twenty presets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "matches": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Candidate"
                      }
                    }
                  },
                  "required": [
                    "matches"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The profiles are not downloaded yet."
          },
          "404": {
            "description": "The printer is not a preset of the Prusa profiles."
          }
        }
      }
    },
    "/presets": {
      "get": {
        "operationId": "search-presets",
        "summary": "Search the Prusa base presets",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "printer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "A printer preset name. Only presets that fit it are returned, as PrusaSlicer's own list shows them."
          }
        ],
        "responses": {
          "200": {
            "description": "Up to 50 presets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "presets": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Candidate"
                      }
                    }
                  },
                  "required": [
                    "presets"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The profiles are not downloaded yet."
          },
          "404": {
            "description": "The printer is not a preset of the Prusa profiles."
          }
        },
        "description": "Searches the base presets by the words of the query, so a person can pick one when the match missed. The host authorizes the caller on this module before the route is called."
      }
    },
    "/bundle": {
      "post": {
        "operationId": "write-bundle",
        "summary": "Write a PrusaSlicer 2.9 Config Bundle",
        "description": "One [filament:NAME] section per request, flattened so it imports alone. With a printer, each profile is the section of its preset that fits that printer, and a [presets] section selects the printer and each filament in its slot.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "filaments": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "$ref": "#/components/schemas/Request"
                    }
                  },
                  "printer": {
                    "type": "string",
                    "description": "A printer preset name. Forced in the bundle's [presets] section, and the preset of each filament is the section that fits it."
                  }
                },
                "required": [
                  "filaments"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The .ini file.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "The request is not valid."
          },
          "404": {
            "description": "A preset does not fit the printer, or the printer or a preset is not in the profiles."
          },
          "503": {
            "description": "The profiles are not downloaded yet."
          }
        }
      }
    },
    "/printers": {
      "get": {
        "operationId": "search-printers",
        "summary": "Search the PrusaSlicer printer presets",
        "description": "The printer presets of the Prusa profiles, by the words of the query, up to 60. The one a bundle forces is chosen from this list.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The printers.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "printers": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Printer"
                      }
                    }
                  },
                  "required": [
                    "printers"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "The profiles are not downloaded yet."
          }
        }
      }
    }
  }
}
